MIN_STATION_COVERAGE=0.75
# No usar las claves compartidas en conversaciones; sustituirlas.
DATA_DIR=data
OUTPUT_DIR=.
# Datos meteorológicos del Ayuntamiento de Madrid.
# Retraso supuesto de publicación de la meteorología municipal.
METEO_LAG_DAYS=7
NO2_LAG_DAYS=1
TRAFFIC_LAG_DAYS=1
USE_TRAFFIC=true
AI_MODE=mock
AI_PROVIDER=google
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.1-flash-lite
RANDOM_STATE=42
