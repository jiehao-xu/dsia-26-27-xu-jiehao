# Solo hace falta para el flujo horario que descarga meteorología.
AEMET_API_KEY=
AEMET_STATION=3195
# Sensores separados por comas. Si lo dejas vacío, se buscan a 500 m.
TRAFFIC_SENSOR_IDS=
TRAFFIC_RADIUS_METERS=500
# Usar el resumen meteorológico de 7 días antes; es una suposición revisable.
AEMET_LAG_DAYS=7

# En run/analyze, mock permite probar sin llamar a Gemini.
# forecast usa la API por defecto; para probarlo usa --ai-mode mock.
AI_MODE=mock
AI_PROVIDER=google
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.1-flash-lite

